    "validate": "npm run validate:packs && npm run validate:challenges && npm run validate:content"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",

          "input": "nums = [-2, 1, -3, 4, -1, 2, 1, -5, 4]",
          "output": "6",
          "explain": "The run [4, -1, 2, 1] adds up to 6."
        },
        {
          "input": "nums = [-3, -1, -2]",
          "output": "-1"
        }
      ],
      "constraints": [
        "1 <= nums.length <= 10^5",
        "-10^4 <= nums[i] <= 10^4"
      ],
      "function": {
        "javascript": "maxSubArray",
        "python": "max_sub_array"
      },
